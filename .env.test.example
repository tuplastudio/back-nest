# =============================================================================
# END-TO-END TEST ENVIRONMENT
# =============================================================================
# The e2e suite provisions and DROPS tenant schemas, so it must point at a
# disposable database — never at production or a shared staging instance.
# =============================================================================

NODE_ENV=test
PORT=3999

CONTROL_PLANE_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mtb_test?schema=public"
CONTROL_PLANE_DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/mtb_test?schema=public"

# Data plane. MUST be a different, non-owning role (mtb_app), otherwise the
# tenant tables' row-level security is not enforced: a table owner bypasses
# it and a superuser bypasses it unconditionally. Required in production.
TENANT_PLANE_DATABASE_URL="postgresql://mtb_app:mtb_app_local_only@localhost:5432/mtb_test?schema=public"
TENANT_PLANE_DATABASE_URL_UNPOOLED="postgresql://mtb_app:mtb_app_local_only@localhost:5432/mtb_test?schema=public"

JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-string-of-32-plus-chars
PII_HMAC_KEY=change-me-blind-index-key
# Same placeholder convention as .env.example: the validator REFUSES these on
# purpose, so a deployment cannot come up on a key that is written in the
# repository. Generate real ones with:
#   openssl rand -base64 32     # PII_ENCRYPTION_KEY (decodes to exactly 32 bytes)
#   openssl rand -base64 24     # PII_HMAC_KEY
PII_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

API_BASE_DOMAIN=api.example.com
DOCS_ENABLED=true
# Mandatory whenever DOCS_ENABLED is true, in every environment; the validator
# refuses the placeholder, so set a real one.
DOCS_BASIC_AUTH_PASSWORD=change-me-docs-password

# Seed credentials used by `npm run prisma:seed`.
#
# Local test values only. prisma/seed.ts requires these explicitly and refuses
# to run outside NODE_ENV=development/test, so nothing here should ever reach a
# real database. They are deliberately not the historic published literal, which
# was the credential a previous audit flagged as live in seeded databases.
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=local-test-owner-password
SEED_TENANT_SLUG=acme
SEED_MEMBER_EMAIL=ada@acme.com
SEED_MEMBER_PASSWORD=local-test-member-password
