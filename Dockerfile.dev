# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# Development image.
#
# Mounts the working tree and runs the compiler in watch mode plus the compiled
# server, which is the only combination that preserves Nest's dependency
# injection metadata (see scripts/dev.mjs for the full explanation).
# ---------------------------------------------------------------------------
FROM node:22-alpine

WORKDIR /app

RUN apk add --no-cache openssl

COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund

COPY tsconfig.json tsconfig.build.json tsconfig.spec.json prisma.config.ts ./
COPY prisma ./prisma
COPY scripts ./scripts
COPY src ./src

RUN npx prisma generate --schema prisma/schema.prisma \
 && npx prisma generate --schema prisma/schema.tenant.prisma

EXPOSE 3000

CMD ["node", "scripts/dev.mjs"]