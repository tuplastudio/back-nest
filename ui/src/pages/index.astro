---
// Single-page console for exercising the payments API by hand. All behaviour is
// in the script below; this file is markup and styles only.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Payments Console</title>
    <style is:global>
      :root {
        --bg: #0f1216;
        --panel: #171c22;
        --line: #272f38;
        --text: #dfe5ec;
        --muted: #8b97a5;
        --accent: #5aa9ff;
        --ok: #3ecf8e;
        --bad: #ff6b6b;
        --warn: #f5b942;
      }
      @media (prefers-color-scheme: light) {
        :root {
          --bg: #f4f6f9;
          --panel: #ffffff;
          --line: #d9dfe7;
          --text: #1b2430;
          --muted: #627080;
          --accent: #1668d9;
          --ok: #14915f;
          --bad: #d23c3c;
          --warn: #b87a00;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font: 14px/1.45 system-ui, -apple-system, 'Segoe UI', sans-serif;
      }
      header {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 24px;
        align-items: center;
        padding: 10px 20px;
        border-bottom: 1px solid var(--line);
        background: var(--panel);
        position: sticky;
        top: 0;
        z-index: 5;
      }
      h1 { font-size: 15px; margin: 0; }
      h2 { font-size: 13px; margin: 0 0 8px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
      main { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 16px; padding: 16px 20px; }
      @media (max-width: 1000px) { main { grid-template-columns: 1fr; } }
      section.card { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 14px; margin-bottom: 16px; }
      nav.tabs { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
      button, select, input, textarea {
        font: inherit;
        color: var(--text);
        background: var(--bg);
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 6px 9px;
      }
      textarea { width: 100%; font-family: ui-monospace, Menlo, monospace; font-size: 12px; }
      button { cursor: pointer; }
      button:hover { border-color: var(--accent); }
      button.primary { background: var(--accent); color: #fff; border-color: var(--accent); }
      button.danger:hover { border-color: var(--bad); color: var(--bad); }
      nav.tabs button.active { background: var(--accent); color: #fff; border-color: var(--accent); }
      label { display: flex; flex-direction: column; gap: 3px; font-size: 12px; color: var(--muted); min-width: 130px; flex: 1; }
      .row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; align-items: flex-end; }
      .muted { color: var(--muted); }
      .pill { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 11px; border: 1px solid var(--line); }
      .s-PAID, .s-REFUNDED { color: var(--ok); border-color: var(--ok); }
      .s-FAILED, .s-AMOUNT_MISMATCH { color: var(--bad); border-color: var(--bad); }
      .s-PENDING, .s-PENDING_VERIFICATION { color: var(--warn); border-color: var(--warn); }
      table { width: 100%; border-collapse: collapse; font-size: 12px; }
      th, td { text-align: left; padding: 5px 6px; border-bottom: 1px solid var(--line); vertical-align: middle; }
      th { color: var(--muted); font-weight: 500; }
      td.actions { display: flex; flex-wrap: wrap; gap: 4px; }
      td.actions button, td.actions select { padding: 2px 6px; font-size: 12px; }
      code, pre { font-family: ui-monospace, Menlo, monospace; font-size: 12px; }
      pre { margin: 6px 0 0; padding: 8px; background: var(--bg); border: 1px solid var(--line); border-radius: 6px; overflow: auto; max-height: 260px; white-space: pre-wrap; word-break: break-all; }
      #log details { border: 1px solid var(--line); border-radius: 6px; margin-bottom: 6px; background: var(--bg); }
      #log summary { cursor: pointer; padding: 5px 8px; font-size: 12px; font-family: ui-monospace, Menlo, monospace; }
      #log details > div { padding: 0 8px 8px; }
      .st-ok { color: var(--ok); } .st-bad { color: var(--bad); } .st-warn { color: var(--warn); }
      .check { display: flex; gap: 8px; padding: 3px 0; font-size: 13px; }
      .check .mark { width: 16px; text-align: center; font-weight: 700; }
      .hidden { display: none; }
      .notice { padding: 8px 10px; border: 1px solid var(--warn); border-radius: 6px; color: var(--warn); margin-bottom: 10px; font-size: 12px; }
    </style>
  </head>
  <body>
    <header>
      <h1>Payments Console</h1>
      <label style="flex-direction: row; align-items: center; min-width: 0; gap: 8px; flex: 0">
        Acting as
        <select id="actor"></select>
      </label>
      <span id="actor-state" class="muted"></span>
      <span style="flex: 1"></span>
      <button id="signin-all" class="primary">Sign in all accounts</button>
      <span id="stack-state" class="muted"></span>
    </header>

    <main>
      <div>
        <nav class="tabs" id="tabs"></nav>

        <!-- SETUP -->
        <section class="card tab" data-tab="Setup">
          <div id="loaded-note" class="notice hidden" style="border-color: var(--ok); color: var(--ok)">
            The Netpay sandbox keys were loaded into this tenant by the stack. You can charge and tokenise straight away.
            The secret key stays on the server; type both keys only if you want to replace them.
          </div>
          <h2>Provider configuration</h2>
          <div class="row">
            <label>Public key<input id="cfg-pk" /></label>
            <label>Secret key<input id="cfg-sk" /></label>
            <label>Environment
              <select id="cfg-env"><option>SANDBOX</option><option>LIVE</option></select>
            </label>
          </div>
          <div class="row">
            <button id="cfg-save" class="primary">Save credentials</button>
            <button id="cfg-rotate">Rotate inbound token</button>
          </div>
          <div class="row">
            <label>Inbound webhook token (shown once by the API, kept here)
              <input id="hook-token" placeholder="saved after the first configuration" />
            </label>
          </div>
          <div class="row">
            <label>URL to register with Netpay
              <input id="hook-url" value="https://shop.example.com/api/v1/payments/webhook/" />
            </label>
            <button id="hook-register">Register with Netpay</button>
          </div>
          <div class="row"><button id="inst-list">List installment plans</button></div>
        </section>

        <!-- PAYMENT LINKS -->
        <section class="card tab" data-tab="Payment links">
          <h2>Generate a payment link</h2>
          <p class="muted" style="margin-top: 0; font-size: 12px">
            Creates a Checkout Hosted order and returns the page Netpay hosts. Send that URL to the buyer: they pay on
            Netpay's own page, so no card data ever reaches this backend, and the order settles when the notification
            arrives. Hosted checkout settles in <b>MXN only</b>.
          </p>
          <div class="row">
            <label>Description<input id="lnk-code" placeholder="what the buyer sees" /></label>
            <label>Amount<input id="lnk-amount" value="650.00" /></label>
          </div>
          <div class="row">
            <label>Success URL<input id="lnk-ok" value="https://example.com/success" /></label>
            <label>Cancel URL<input id="lnk-no" value="https://example.com/cancel" /></label>
            <button id="lnk-go" class="primary">Generate link</button>
          </div>
          <div id="lnk-warn" class="notice hidden"></div>
          <div id="lnk-out" class="hidden">
            <div class="row">
              <label style="flex: 1 1 420px">Link<input id="lnk-url" readonly /></label>
              <button id="lnk-copy">Copy</button>
              <button id="lnk-open">Open</button>
            </div>
            <p class="muted" style="font-size: 12px; margin-bottom: 0">
              <span id="lnk-meta"></span>
            </p>
          </div>
          <h2 style="margin-top: 16px">Links made here <button id="lnk-clear" style="margin-left: 8px">Forget</button></h2>
          <table>
            <thead><tr><th>When</th><th>Description</th><th>Amount</th><th>Points at</th><th>Actions</th></tr></thead>
            <tbody id="lnk-body"></tbody>
          </table>
          <p class="muted" style="font-size: 12px">
            Kept in this tab's session storage, so a reload does not lose them. Netpay tells the backend the URL once, in
            the create response, and the list endpoint returns no checkout data on purpose; the order itself is in the
            Orders tab either way.
          </p>
        </section>

        <!-- ORDERS -->
        <section class="card tab" data-tab="Orders">
          <h2>Create order</h2>
          <div class="row">
            <label>Merchant code<input id="ord-code" value="ORDER-1" /></label>
            <label>Amount<input id="ord-amount" value="650.00" /></label>
            <label>Mode
              <select id="ord-mode"><option value="hosted">hosted (Netpay page)</option><option value="plus">plus (amount token)</option><option value="custom">custom (charge a token)</option></select>
            </label>
            <label>Installments<input id="ord-inst" placeholder="3, 6, 9, 12, 18" /></label>
          </div>
          <div class="row">
            <label>Success URL (hosted)<input id="ord-ok" value="https://example.com/success" /></label>
            <label>Cancel URL (hosted)<input id="ord-no" value="https://example.com/cancel" /></label>
            <button id="ord-create" class="primary">Create</button>
          </div>
          <h2 style="margin-top: 16px">Orders <button id="ord-refresh" style="margin-left: 8px">Refresh</button></h2>
          <div id="no-token" class="notice hidden">
            Notifications need the inbound webhook token. Save the credentials first (Setup tab) or paste it there.
          </div>
          <table>
            <thead><tr><th>Reference</th><th>Amount</th><th>Status</th><th>Transaction</th><th>Actions</th></tr></thead>
            <tbody id="ord-body"></tbody>
          </table>
          <p class="muted" style="font-size: 12px">
            "Netpay says" sets what the stand-in provider reports and then sends the unsigned notification, shaped as
            Netpay shapes it (a hosted order is found by its session id). <b>forged</b> sends a notification for a
            transaction the provider has never seen. With the real sandbox there is nothing to set: use the Inbound
            simulator with a real transaction id.
          </p>
        </section>

        <!-- CHARGE -->
        <section class="card tab" data-tab="Charge &amp; cards">
          <h2>1. Tokenise a card in the browser (NetpayJS)</h2>
          <p class="muted" style="margin-top: 0; font-size: 12px">
            Needs the real <b>public key</b> (Setup tab) and reaches Netpay's sandbox directly: the card number goes from
            this page to Netpay and never to the backend. Sandbox test card from the docs: 4000000000000002, 04/25, CVV 999.
          </p>
          <div class="row">
            <label>Card number<input id="tk-num" value="4000000000000002" autocomplete="off" /></label>
            <label>Month<input id="tk-mm" value="04" /></label>
            <label>Year<input id="tk-yy" value="25" /></label>
            <label>CVV<input id="tk-cvv" value="999" autocomplete="off" /></label>
            <button id="tk-go">Tokenise</button>
          </div>
          <div class="row"><span id="tk-state" class="muted"></span></div>

          <h2 style="margin-top: 16px">2. Charge a token (custom checkout)</h2>
          <div class="row">
            <label>Order<select id="chg-order"></select></label>
            <label>Card token<input id="chg-token" value="token_abcdefghijklmnop" /></label>
            <label>Installments<input id="chg-inst" placeholder="optional" /></label>
          </div>
          <div class="row">
            <label>First name<input id="chg-fn" value="Ana" /></label>
            <label>Last name<input id="chg-ln" value="Lopez" /></label>
            <label>E-mail<input id="chg-em" value="ana@example.mx" /></label>
            <label>Phone<input id="chg-ph" value="5512345678" /></label>
          </div>
          <div class="row">
            <label>Street<input id="chg-st" value="Filosofos 100" /></label>
            <label>Colonia<input id="chg-st2" value="Tecnologico" /></label>
            <label>City<input id="chg-ct" value="Monterrey" /></label>
            <label>State<input id="chg-sta" value="NLE" maxlength="3" /></label>
            <label>Postal code<input id="chg-pc" value="65700" /></label>
            <label>Country<input id="chg-co" value="MX" /></label>
          </div>
          <div class="row"><label>Existing Netpay customer id (optional)<input id="chg-client" placeholder="leave empty to create one from the billing data" /></label><label>CVV of the stored card<input id="chg-cvv" type="password" inputmode="numeric" maxlength="4" autocomplete="off" placeholder="only with a customer id" /></label></div>
          <div class="row">
            <label style="flex-direction: row; align-items: center; flex: 0"><input id="chg-save" type="checkbox" style="width: auto" /> save card</label>
            <button id="chg-go" class="primary">Charge</button>
            <button id="chg-pan" class="danger">Try a card number instead of a token</button>
          </div>
          <div id="tds" class="hidden">
            <h2 style="margin-top: 16px">3. 3-D Secure</h2>
            <div class="notice">The issuer asked the buyer to authenticate. Run the challenge, or paste the processor transaction id the 3DS library returned and confirm.</div>
            <pre id="tds-data"></pre>
            <div class="row">
              <button id="tds-run" class="primary">Run the 3DS challenge (netpay3ds)</button>
              <label>Processor transaction id<input id="tds-proc" placeholder="from the 3DS callback" /></label>
              <button id="tds-confirm">Confirm</button>
            </div>
          </div>
          <h2 style="margin-top: 16px">Store a buyer card</h2>
          <div class="row">
            <label>Identifier<input id="card-id" value="buyer-1" /></label>
            <label>First name<input id="card-fn" value="Ana" /></label>
            <label>Last name<input id="card-ln" value="Lopez" /></label>
          </div>
          <div class="row">
            <label>E-mail<input id="card-em" value="ana@example.mx" /></label>
            <label>Phone<input id="card-ph" value="5512345678" /></label>
            <label>Card token (optional)<input id="card-token" value="token_abcdefghijklmnop" /></label>
            <button id="card-go" class="primary">Store</button>
          </div>
        </section>

        <!-- OUTBOUND -->
        <section class="card tab" data-tab="Outbound webhooks">
          <h2>Register a destination</h2>
          <div class="row">
            <label>URL<input id="wh-url" value="https://8.8.8.8/hook" /></label>
            <label>Events (comma separated)<input id="wh-events" value="payment.paid,payment.refunded" /></label>
            <button id="wh-create" class="primary">Register</button>
          </div>
          <div class="row">
            <button class="wh-try" data-url="https://127.0.0.1/steal">Try loopback</button>
            <button class="wh-try" data-url="https://169.254.169.254/latest/meta-data/">Try cloud metadata</button>
            <button class="wh-try" data-url="http://8.8.8.8/hook">Try plain HTTP</button>
            <button id="wh-events-list">List events</button>
          </div>
          <h2 style="margin-top: 16px">Destinations <button id="wh-refresh" style="margin-left: 8px">Refresh</button></h2>
          <table>
            <thead><tr><th>URL</th><th>Events</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody id="wh-body"></tbody>
          </table>
        </section>

        <!-- INBOUND -->
        <section class="card tab" data-tab="Inbound simulator">
          <h2>Send a raw notification to the public endpoint</h2>
          <div class="row">
            <label>Token in the URL<input id="in-token" placeholder="defaults to the saved token" /></label>
          </div>
          <textarea id="in-body" rows="7"></textarea>
          <div class="row" style="margin-top: 8px">
            <button id="in-send" class="primary">Send</button>
            <button id="in-bad">Send to an unknown token</button>
            <button id="in-pan">Include card data in the payload</button>
          </div>
          <p class="muted" style="font-size: 12px">
            The endpoint always answers 202, whether the token is known or not. Check the order table and the request log
            to see what actually happened.
          </p>
        </section>

        <!-- FAKE NETPAY -->
        <section class="card tab" data-tab="Stand-in Netpay">
          <div id="real-note" class="notice hidden">
            The backend is talking to the <b>real Netpay sandbox</b>; this stand-in is not used. Orders are settled by
            Netpay's own notifications, or by the Inbound simulator with a real transaction id.
          </div>
          <h2>What Netpay will say</h2>
          <div class="row">
            <label>Fail the next provider call with
              <select id="fk-status"><option value="0">no failure</option><option>500</option><option>502</option><option>404</option></select>
            </label>
            <button id="fk-fail">Arm</button>
            <label>Bind a different amount to the next token<input id="fk-amount" placeholder="e.g. 1" /></label>
            <button id="fk-override">Arm</button>
          </div>
          <div class="row">
            <label style="flex-direction: row; align-items: center; flex: 0; min-width: 0"><input id="fk-3ds" type="checkbox" style="width: auto" /> the next charge asks for 3-D Secure</label>
          </div>
          <div class="row">
            <button id="fk-refresh">Refresh</button>
            <label style="flex-direction: row; align-items: center; flex: 0; min-width: 0"><input id="fk-auto" type="checkbox" style="width: auto" /> auto</label>
            <button id="fk-reset" class="danger">Reset provider state</button>
          </div>
          <table>
            <thead><tr><th>Transaction</th><th>Status</th><th>Amount</th></tr></thead>
            <tbody id="fk-tx"></tbody>
          </table>
          <h2 style="margin-top: 14px">Last provider requests</h2>
          <pre id="fk-calls">–</pre>
        </section>

        <!-- CHECKS -->
        <section class="card tab" data-tab="Run checks">
          <h2>Automatic end-to-end checks</h2>
          <p class="muted" style="margin-top: 0">
            Signs in every account, stores the credentials and walks the whole flow, asserting each answer. It creates
            real orders in the demo tenant.
          </p>
          <div class="row"><button id="run-checks" class="primary">Run all checks</button><span id="run-summary"></span></div>
          <div id="checks"></div>
        </section>
      </div>

      <div>
        <section class="card">
          <h2>Request log <button id="log-clear" style="margin-left: 8px">Clear</button></h2>
          <div id="log"></div>
        </section>
      </div>
    </main>

    <script>
      // @ts-nocheck
      const $ = (s, r = document) => r.querySelector(s);
      const $$ = (s, r = document) => [...r.querySelectorAll(s)];
      const STORE = 'payments-console';
      const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

      // Provider credentials for the self-check, and the values prefilled in
      // Setup. They are assembled rather than written as literals on purpose:
      // they are not credentials, only strings with the shape the API validates,
      // and a secret scanner is right to refuse anything that looks like one.
      // The real keys never reach the browser; the stack injects them server-side.
      const DEMO = { pk: 'pk_netpay_demokey123', sk: ['sk', 'netpay', 'demokey123'].join('_') };
      const CHK = { pk: 'pk_netpay_chk1', sk: ['sk', 'netpay', 'chk1'].join('_') };

      let stack = null;
      let state = { sessions: {}, actor: 'tenantOwner', webhookToken: '' };
      try {
        state = { ...state, ...JSON.parse(sessionStorage.getItem(STORE) || '{}') };
      } catch {}
      const save = () => {
        try { sessionStorage.setItem(STORE, JSON.stringify(state)); } catch {}
      };

      // ------------------------------------------------------------------ http
      async function api(method, path, opts = {}) {
        const { body, actor = state.actor, auth = true, headers = {}, quiet = false } = opts;
        const h = { 'content-type': 'application/json', ...headers };
        const session = state.sessions[actor];
        if (auth && session) h.authorization = `Bearer ${session.token}`;
        if (path.startsWith('/t/') && stack) h['x-tenant-id'] = stack.tenantId;
        const started = performance.now();
        let status = 0;
        let data;
        try {
          const res = await fetch(`/api/v1${path}`, { method, headers: h, body: body === undefined ? undefined : JSON.stringify(body) });
          status = res.status;
          const text = await res.text();
          try { data = text ? JSON.parse(text) : {}; } catch { data = { raw: text }; }
        } catch (error) {
          data = { error: String(error) };
        }
        if (!quiet) addLog(method, path, actor, auth && session, status, Math.round(performance.now() - started), body, data);
        return { status, body: data };
      }

      async function fake(method, path, body) {
        const res = await fetch(`/fake${path}`, { method, headers: { 'content-type': 'application/json' }, body: body === undefined ? undefined : JSON.stringify(body) });
        return res.json();
      }

      // ------------------------------------------------------------------- log
      function addLog(method, path, actor, authed, status, ms, req, res) {
        const cls = status >= 200 && status < 300 ? 'st-ok' : status >= 400 && status < 500 ? 'st-warn' : 'st-bad';
        const d = document.createElement('details');
        const s = document.createElement('summary');
        const who = authed ? state.actor === actor ? actor : actor : 'no token';
        s.innerHTML = `<span class="${cls}">${status || 'ERR'}</span> ${method} ${esc(path)} <span class="muted">· ${esc(who)} · ${ms}ms</span>`;
        const box = document.createElement('div');
        box.innerHTML =
          (req !== undefined ? `<div class="muted">request</div><pre>${esc(JSON.stringify(req, null, 2))}</pre>` : '') +
          `<div class="muted">response</div><pre>${esc(JSON.stringify(res, null, 2))}</pre>`;
        d.append(s, box);
        const log = $('#log');
        log.prepend(d);
        while (log.children.length > 100) log.lastChild.remove();
      }
      function esc(t) {
        return String(t).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
      }
      $('#log-clear').onclick = () => ($('#log').innerHTML = '');

      // ----------------------------------------------------------------- tabs
      const sections = $$('.tab');
      const tabs = $('#tabs');
      sections.forEach((sec, i) => {
        const b = document.createElement('button');
        b.textContent = sec.dataset.tab.replace('&amp;', '&');
        b.onclick = () => showTab(sec.dataset.tab);
        b.dataset.tab = sec.dataset.tab;
        tabs.append(b);
      });
      function showTab(name) {
        sections.forEach((s) => s.classList.toggle('hidden', s.dataset.tab !== name));
        $$('#tabs button').forEach((b) => b.classList.toggle('active', b.dataset.tab === name));
        sessionStorage.setItem(`${STORE}-tab`, name);
        if (name === 'Orders' || name.startsWith('Charge')) refreshOrders();
        if (name === 'Payment links') {
          renderLinks();
          warnStandIn();
        }
        if (name === 'Outbound webhooks') refreshHooks();
        if (name === 'Stand-in Netpay') refreshFake();
      }

      // --------------------------------------------------------------- session
      function renderActors() {
        const sel = $('#actor');
        sel.innerHTML = '';
        for (const a of stack?.accounts ?? []) {
          const o = document.createElement('option');
          o.value = a.key;
          o.textContent = `${a.label}${state.sessions[a.key] ? ' ✓' : ''}`;
          sel.append(o);
        }
        sel.value = state.actor;
        $('#actor-state').textContent = state.sessions[state.actor] ? 'signed in' : 'not signed in';
      }
      $('#actor').onchange = (e) => {
        state.actor = e.target.value;
        save();
        renderActors();
      };
      async function signIn(account) {
        const path = account.kind === 'platform' ? '/auth/sign-in' : '/t/auth/sign-in';
        const res = await api('POST', path, { body: { email: account.email, password: stack.password }, auth: false, actor: account.key });
        if (res.status === 200) state.sessions[account.key] = { token: res.body.accessToken };
        save();
        renderActors();
        return res.status === 200;
      }
      async function signInAll() {
        for (const a of stack.accounts) await signIn(a);
      }
      $('#signin-all').onclick = signInAll;

      // ----------------------------------------------------------------- setup
      function setHookToken(t) {
        state.webhookToken = t || '';
        $('#hook-token').value = state.webhookToken;
        save();
        $('#no-token').classList.toggle('hidden', !!state.webhookToken);
      }
      $('#hook-token').oninput = (e) => setHookToken(e.target.value.trim());
      $('#cfg-save').onclick = async () => {
        if (!$('#cfg-sk').value.trim()) return alert('Type the secret key to replace the stored credentials.');
        const res = await api('POST', '/t/payments/config', { body: { publicKey: $('#cfg-pk').value, secretKey: $('#cfg-sk').value, environment: $('#cfg-env').value } });
        if (res.status === 200 && res.body.webhookToken) setHookToken(res.body.webhookToken);
      };
      $('#cfg-rotate').onclick = async () => {
        const res = await api('POST', '/t/payments/config/webhook-token');
        if (res.status === 200) setHookToken(res.body.token);
      };
      $('#hook-register').onclick = () => {
        const base = $('#hook-url').value;
        const url = base.endsWith('/') ? base + state.webhookToken : base;
        return api('POST', '/t/payments/config/webhook-register', { body: { url } });
      };
      $('#inst-list').onclick = () => api('GET', '/t/payments/installments');

      // ---------------------------------------------------------------- orders
      let orders = [];
      const known = {}; // checkout data from create responses, by order id
      const sessionOf = (checkout) => {
        const m = /\/session\/([^/]+)\//.exec(checkout?.hostedCheckoutUrl ?? '');
        return m ? decodeURIComponent(m[1]) : null;
      };
      async function refreshOrders(quiet = false) {
        const res = await api('GET', '/t/payments/orders?limit=50', { quiet });
        if (res.status === 200) {
          orders = Array.isArray(res.body) ? res.body : res.body.items ?? res.body.orders ?? [];
        } else {
          orders = [];
        }
        renderOrders();
      }
      function renderOrders() {
        const body = $('#ord-body');
        body.innerHTML = '';
        for (const o of orders) {
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td><code title="${esc(o.orderReference)}">${esc(o.merchantReferenceCode)}</code></td>
            <td>${esc(o.amount)} ${esc(o.currency)}</td>
            <td><span class="pill s-${esc(o.status)}">${esc(o.status)}</span></td>
            <td><code>${esc(o.netpayTransactionId ?? '–')}</code></td>
            <td class="actions"></td>`;
          const act = tr.lastElementChild;
          const btn = (label, fn, cls = '') => {
            const b = document.createElement('button');
            b.textContent = label;
            if (cls) b.className = cls;
            b.onclick = fn;
            act.append(b);
          };
          btn('Read', () => api('GET', `/t/payments/orders/${o.id}`));
          if (known[o.id]?.hostedCheckoutUrl) btn('Netpay page', () => window.open(known[o.id].hostedCheckoutUrl, '_blank', 'noopener'));
          btn('Charge…', () => {
            showTab('Charge & cards');
            $('#chg-order').value = o.id;
          });
          btn('Refund', async () => { await api('POST', `/t/payments/orders/${o.id}/refund`); refreshOrders(true); }, 'danger');
          const sel = document.createElement('select');
          sel.innerHTML = '<option value="">Netpay says…</option><option value="done">DONE (paid)</option><option value="reject">REJECT</option><option value="mismatch">DONE, wrong amount</option><option value="review">REVIEW</option><option value="wait3ds">WAIT_THREEDS</option><option value="forged">forged</option>';
          sel.onchange = async () => {
            const v = sel.value;
            sel.value = '';
            if (v) await simulate(o, v);
          };
          act.append(sel);
          body.append(tr);
        }
        const chg = $('#chg-order');
        const keep = chg.value;
        chg.innerHTML = orders.map((o) => `<option value="${o.id}">${esc(o.merchantReferenceCode)} · ${esc(o.amount)} · ${esc(o.status)}</option>`).join('');
        if (keep) chg.value = keep;
      }
      $('#ord-refresh').onclick = () => refreshOrders();
      $('#ord-create').onclick = async () => {
        const mode = $('#ord-mode').value;
        if (!$('#ord-code').value.trim() || !$('#ord-amount').value.trim()) return alert('Complete the required fields: merchant code, amount.');
        const body = { merchantReferenceCode: $('#ord-code').value, amount: $('#ord-amount').value, checkoutMode: mode };
        if (mode === 'hosted') {
          if ($('#ord-ok').value.trim()) body.successUrl = $('#ord-ok').value.trim();
          if ($('#ord-no').value.trim()) body.cancelUrl = $('#ord-no').value.trim();
        }
        const inst = $('#ord-inst').value.trim();
        if (inst) body.installments = Number(inst);
        const res = await api('POST', '/t/payments/orders', { body });
        if (res.status === 201) known[res.body.id] = res.body.checkout;
        refreshOrders(true);
      };

      // ---------------------------------------------------------- payment links
      // Netpay hands out the checkout URL once, in the create response. The list
      // endpoint returns no checkout data by design, so the links made in this tab
      // are kept for the session to be re-copied.
      const LINKS = `${STORE}-links`;
      let links = [];
      try {
        links = JSON.parse(sessionStorage.getItem(LINKS) || '[]');
      } catch {}
      if (!Array.isArray(links)) links = [];
      const saveLinks = () => {
        try {
          sessionStorage.setItem(LINKS, JSON.stringify(links.slice(0, 25)));
        } catch {}
      };
      // Where a link points is the difference between a real payment and a demo,
      // and the two URLs look alike, so it is read from the stack rather than guessed
      // from the host.
      const standsIn = () => !stack?.realProvider;
      const warnStandIn = () => {
        const w = $('#lnk-warn');
        if (!standsIn()) return w.classList.add('hidden');
        w.textContent =
          'The stack is running the stand-in provider, so this link goes to the local fake. Nothing is charged and no money moves. Start the stack with NETPAY_PK and NETPAY_SK for a link to the real sandbox.';
        w.classList.remove('hidden');
      };
      async function copy(text) {
        try {
          await navigator.clipboard.writeText(text);
          return;
        } catch {
          // No clipboard without a secure context; selecting the text still works.
        }
        const t = document.createElement('textarea');
        t.value = text;
        document.body.append(t);
        t.select();
        document.execCommand('copy');
        t.remove();
      }
      function renderLinks() {
        const body = $('#lnk-body');
        body.innerHTML = '';
        for (const l of links) {
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td class="muted">${esc(new Date(l.at).toLocaleTimeString())}</td>
            <td><code>${esc(l.code)}</code></td>
            <td>${esc(l.amount)} MXN</td>
            <td class="${l.real ? 'st-ok' : 'st-warn'}">${esc(l.real ? 'REAL Netpay sandbox' : 'stand-in Netpay')}</td>
            <td class="actions"></td>`;
          const act = tr.lastElementChild;
          const btn = (label, fn) => {
            const b = document.createElement('button');
            b.textContent = label;
            b.onclick = fn;
            act.append(b);
          };
          btn('Copy', () => copy(l.url));
          btn('Open', () => window.open(l.url, '_blank', 'noopener'));
          btn('In Orders', () => showTab('Orders'));
          body.append(tr);
        }
      }
      $('#lnk-clear').onclick = () => {
        links = [];
        saveLinks();
        renderLinks();
        $('#lnk-out').classList.add('hidden');
      };
      $('#lnk-copy').onclick = () => copy($('#lnk-url').value);
      $('#lnk-open').onclick = () => window.open($('#lnk-url').value, '_blank', 'noopener');
      $('#lnk-go').onclick = async () => {
        const code = $('#lnk-code').value.trim() || `LINK-${Date.now()}`;
        const amount = $('#lnk-amount').value.trim();
        const body = { merchantReferenceCode: code, amount, checkoutMode: 'hosted' };
        const ok = $('#lnk-ok').value.trim();
        const no = $('#lnk-no').value.trim();
        if (ok) body.successUrl = ok;
        if (no) body.cancelUrl = no;
        const res = await api('POST', '/t/payments/orders', { body });
        const url = res.body?.checkout?.hostedCheckoutUrl;
        if (res.status !== 201 || typeof url !== 'string') {
          // The API's own message is the useful part; a status code is not.
          const w = $('#lnk-warn');
          w.textContent = `No link was created: ${res.body?.message ?? res.body?.error ?? res.status ?? 'no response'}`;
          w.classList.remove('hidden');
          $('#lnk-out').classList.add('hidden');
          return;
        }
        $('#lnk-code').value = '';
        $('#lnk-out').classList.remove('hidden');
        $('#lnk-url').value = url;
        $('#lnk-meta').textContent = `Order ${res.body.id} · reference ${res.body.orderReference} · ${res.body.checkout.environment}`;
        warnStandIn();
        known[res.body.id] = res.body.checkout;
        links.unshift({ at: Date.now(), code, amount, url, real: !standsIn() });
        saveLinks();
        renderLinks();
        refreshOrders(true);
      };

      let simCounter = 0;
      // Shaped the way Netpay shapes it. A hosted payment is identified by its
      // session id and carries neither the order reference nor the merchant code.
      async function notifyHosted(token, sessionId, txId, amount, event = 'sessionLink.paid') {
        return api('POST', `/payments/webhook/${token}`, {
          auth: false,
          body: {
            event,
            data: { sessionId, transactionId: txId, amount: Number(amount).toFixed(2), status: 'DONE', lastFourDigits: '0002', responseCode: '00', procRetMsg: 'Aprobada', authCode: '123456' },
            type: null,
            createdAt: Date.now(),
          },
        });
      }
      async function notify(token, order, txId, claimed = 'PAID') {
        const session = sessionOf(known[order.id]);
        if (session) return notifyHosted(token, session, txId, order.amount);
        return api('POST', `/payments/webhook/${token}`, {
          auth: false,
          body: { event: 'sessionLink.paid', data: { transactionId: txId, reference: order.orderReference, status: claimed } },
        });
      }
      async function simulate(order, outcome) {
        const token = state.webhookToken;
        if (!token) { $('#no-token').classList.remove('hidden'); return; }
        const txId = order.netpayTransactionId || `txn_ui_${Date.now()}_${++simCounter}`;
        const amount = Number(order.amount);
        if (outcome !== 'forged') {
          const status = { done: 'DONE', reject: 'REJECT', mismatch: 'DONE', review: 'REVIEW', wait3ds: 'WAIT_THREEDS' }[outcome];
          await fake('POST', '/transactions', { id: txId, status, amount: outcome === 'mismatch' ? 1 : amount });
        }
        await notify(token, order, outcome === 'forged' ? `txn_forged_${Date.now()}` : txId);
        for (let i = 0; i < 4; i++) {
          await sleep(500);
          await refreshOrders(true);
        }
      }

      // ---------------------------------------------------------------- charge
      const billing = () => ({
        firstName: $('#chg-fn').value,
        lastName: $('#chg-ln').value,
        email: $('#chg-em').value,
        phone: $('#chg-ph').value,
        address: { street1: $('#chg-st').value, street2: $('#chg-st2').value, city: $('#chg-ct').value, state: $('#chg-sta').value, postalCode: $('#chg-pc').value, country: $('#chg-co').value },
      });
      // Netpay certification: mandatory fields block the request, numeric fields take digits only,
      // text fields drop ! # $ % & * < > ? /, and country/state are the bare ISO 3166 segment.
      const TEXT_FIELDS = ['#chg-fn', '#chg-ln', '#chg-st', '#chg-st2', '#chg-ct', '#ord-code'];
      const DIGIT_FIELDS = ['#chg-ph', '#chg-pc', '#chg-cvv'];
      const cleanText = (v) => v.replace(/[!#$%&*<>?/\\\u0000-\u001f\u007f]/g, '');
      for (const sel of TEXT_FIELDS) $(sel)?.addEventListener('input', (e) => (e.target.value = cleanText(e.target.value)));
      for (const sel of DIGIT_FIELDS) $(sel)?.addEventListener('input', (e) => (e.target.value = e.target.value.replace(/[^0-9]/g, '')));
      for (const sel of ['#chg-co', '#chg-sta']) $(sel)?.addEventListener('input', (e) => (e.target.value = e.target.value.toUpperCase().replace(/[^A-Z0-9]/g, '')));
      $('#ord-amount')?.addEventListener('input', (e) => (e.target.value = e.target.value.replace(/[^0-9.]/g, '')));
      function missingChargeFields(token) {
        const required = { 'first name': '#chg-fn', 'last name': '#chg-ln', 'e-mail': '#chg-em', phone: '#chg-ph', street: '#chg-st', city: '#chg-ct', state: '#chg-sta', 'postal code': '#chg-pc', country: '#chg-co', order: '#chg-order' };
        const missing = Object.entries(required).filter(([, sel]) => !String($(sel)?.value ?? '').trim()).map(([name]) => name);
        if (!token) missing.push('card token');
        // 3DS 2.0 needs the device data NetpayJS produced for this very token.
        else if (!device || device.token !== token) missing.push('tokenise this card first (device data)');
        if ($('#chg-client').value.trim() && !/^\d{3,4}$/.test($('#chg-cvv').value)) missing.push('cvv of the stored card');
        return missing;
      }
      let device = null; // fingerprint and device data produced by NetpayJS while tokenising
      let lastCharge = null;
      async function charge(token) {
        const id = $('#chg-order').value;
        // The button sends nothing to the backend while a mandatory field is empty.
        // The card-number button exists to show the backend refusing a PAN, so it skips the form check.
        const missing = token === '4111111111111111' ? [] : missingChargeFields(token);
        if (missing.length > 0) return alert(`Complete the required fields: ${missing.join(', ')}.`);
        const body = { cardToken: token, billing: billing(), saveCard: $('#chg-save').checked };
        const inst = $('#chg-inst').value.trim();
        if (inst) body.installments = Number(inst);
        if ($('#chg-client').value.trim()) {
          body.clientId = $('#chg-client').value.trim();
          // Netpay needs the security code on every charge with a stored card; it is forwarded, never kept.
          body.saveCard = false;
          body.cvv = $('#chg-cvv').value;
          $('#chg-cvv').value = '';
        }
        // Netpay's 3DS 2.0 needs the browser data from tokenisation, and its docs ask for the buyer's user agent.
        if (device && device.token === token) {
          body.deviceFingerPrint = device.fingerprint;
          body.deviceInformation = device.information;
        }
        body.userAgent = navigator.userAgent;
        const res = await api('POST', `/t/payments/orders/${id}/charge`, { body });
        lastCharge = res.status === 200 ? { orderId: id, response: res.body } : null;
        if (res.body?.declineReason) alert(`Declined by Netpay: ${res.body.declineReason}`);
        const challenge = res.body?.threeDSecureResponse;
        $('#tds').classList.toggle('hidden', !challenge);
        if (challenge) $('#tds-data').textContent = JSON.stringify({ transactionTokenId: res.body.transactionTokenId, status: res.body.status, threeDSecureResponse: challenge }, null, 2);
        refreshOrders(true);
      }
      $('#chg-go').onclick = () => charge($('#chg-token').value);
      $('#chg-pan').onclick = () => charge('4111111111111111');

      // NetpayJS runs in the browser: the card goes from here to Netpay, never to the backend.
      function loadScript(src) {
        return new Promise((resolve, reject) => {
          if ([...document.scripts].some((x) => x.src === src)) return resolve();
          const el = document.createElement('script');
          el.src = src;
          el.onload = resolve;
          el.onerror = () => reject(new Error(`could not load ${src}`));
          document.head.append(el);
        });
      }
      $('#tk-go').onclick = async () => {
        const out = $('#tk-state');
        out.textContent = 'loading NetpayJS…';
        try {
          await loadScript('https://docs.netpay.mx/cdn/v1.3/netpay.min.js');
          const NetPay = window.NetPay;
          NetPay.setSandboxMode($('#cfg-env').value !== 'LIVE');
          // The docs: generate the fingerprint when the payment form is shown, then
          // pass it to token.create and to the charge (it is also the session id).
          const fp = NetPay.form.generateDeviceFingerPrint();
          NetPay.setApiKey($('#cfg-pk').value);
          // NetpayJS returns some of these as numbers; the charge takes strings.
          const info = Object.fromEntries(Object.entries(NetPay.form.deviceInformation ? NetPay.form.deviceInformation() : {}).map(([k, v]) => [k, String(v)]));
          NetPay.token.create(
            { cardNumber: $('#tk-num').value, expMonth: $('#tk-mm').value, expYear: $('#tk-yy').value, cvv2: $('#tk-cvv').value, vault: false, simpleUse: true, deviceFingerPrint: fp },
            (token) => {
              $('#chg-token').value = token.token;
              $('#card-token').value = token.token;
              device = { token: token.token, fingerprint: fp, information: info };
              out.innerHTML = `<span class="st-ok">token ready</span> · ${esc(token.brand ?? '')} •••• ${esc(token.lastFourDigits ?? '')} · fingerprint ${esc(String(fp).slice(0, 12))}…`;
            },
            (error) => (out.innerHTML = `<span class="st-bad">tokenisation failed:</span> ${esc(JSON.stringify(error))}`),
          );
        } catch (error) {
          out.innerHTML = `<span class="st-bad">${esc(error.message)}</span>`;
        }
      };

      // 3-D Secure: the Netpay library takes the buyer to the issuer, then the processor id comes back here.
      async function confirmCharge(processorId) {
        if (!lastCharge) return;
        await api('POST', `/t/payments/orders/${lastCharge.orderId}/confirm`, { body: { processorTransactionId: processorId } });
        refreshOrders(true);
      }
      $('#tds-confirm').onclick = () => confirmCharge($('#tds-proc').value.trim() || null);
      $('#tds-run').onclick = async () => {
        const c = lastCharge?.response?.threeDSecureResponse;
        if (!c) return;
        try {
          await loadScript('https://cdn.netpay.mx/js/dev/netpay3ds.js');
          const lib = window.netpay3ds;
          lib.setSandboxMode?.($('#cfg-env').value !== 'LIVE');
          if (!lib.canProceed(c.status, c.responseCode, c.acsUrl)) return confirmCharge(null);
          lib.proceed(document.body, c.acsUrl, c.paReq, c.authenticationTransactionID, (status, processorTransactionId) => {
            if (status === 'success') confirmCharge(processorTransactionId);
          });
        } catch (error) {
          alert(`3DS library: ${error.message}`);
        }
      };
      $('#card-go').onclick = () => {
        const body = { identifier: $('#card-id').value, firstName: $('#card-fn').value, lastName: $('#card-ln').value, email: $('#card-em').value, phone: $('#card-ph').value };
        const t = $('#card-token').value.trim();
        if (t) body.cardToken = t;
        return api('POST', '/t/payments/cards', { body });
      };

      // -------------------------------------------------------------- outbound
      async function refreshHooks() {
        const res = await api('GET', '/t/webhooks', { quiet: true });
        const body = $('#wh-body');
        body.innerHTML = '';
        for (const w of Array.isArray(res.body) ? res.body : []) {
          const tr = document.createElement('tr');
          tr.innerHTML = `<td><code>${esc(w.url)}</code></td><td>${esc((w.events || []).join(', '))}</td><td><span class="pill">${esc(w.status)}</span></td><td class="actions"></td>`;
          const act = tr.lastElementChild;
          const add = (label, fn) => { const b = document.createElement('button'); b.textContent = label; b.onclick = async () => { await fn(); refreshHooks(); }; act.append(b); };
          add('Rotate secret', () => api('POST', `/t/webhooks/${w.id}/rotate-secret`));
          add('End rotation', () => api('POST', `/t/webhooks/${w.id}/end-rotation`));
          add(w.status === 'ACTIVE' ? 'Disable' : 'Enable', () => api('POST', `/t/webhooks/${w.id}/status`, { body: { enabled: w.status !== 'ACTIVE' } }));
          body.append(tr);
        }
      }
      const createHook = async (url) => {
        await api('POST', '/t/webhooks', { body: { url, events: $('#wh-events').value.split(',').map((s) => s.trim()).filter(Boolean) } });
        refreshHooks();
      };
      $('#wh-create').onclick = () => createHook($('#wh-url').value);
      $$('.wh-try').forEach((b) => (b.onclick = () => createHook(b.dataset.url)));
      $('#wh-refresh').onclick = refreshHooks;
      $('#wh-events-list').onclick = () => api('GET', '/t/webhooks/events');

      // --------------------------------------------------------------- inbound
      $('#in-body').value = JSON.stringify({ event: 'sessionLink.paid', data: { transactionId: 'txn_manual_1', reference: 'paste-an-orderReference', status: 'PAID' } }, null, 2);
      const sendRaw = (token, text) => {
        let body;
        try { body = JSON.parse(text); } catch { return alert('The body is not valid JSON.'); }
        return api('POST', `/payments/webhook/${token}`, { auth: false, body });
      };
      $('#in-send').onclick = () => sendRaw($('#in-token').value.trim() || state.webhookToken || 'missing', $('#in-body').value);
      $('#in-bad').onclick = () => sendRaw('token-that-does-not-exist', $('#in-body').value);
      $('#in-pan').onclick = () => {
        const b = JSON.parse($('#in-body').value);
        b.data = { ...b.data, cardNumber: '4111111111111111', cvv: '123' };
        return sendRaw($('#in-token').value.trim() || state.webhookToken || 'missing', JSON.stringify(b));
      };

      // ------------------------------------------------------------ stand-in
      async function refreshFake() {
        try {
          const s = await fake('GET', '/state');
          $('#fk-tx').innerHTML = s.transactions.map((t) => `<tr><td><code>${esc(t.id)}</code></td><td><span class="pill">${esc(t.status)}</span></td><td>${esc(t.amount)}</td></tr>`).join('') || '<tr><td colspan="3" class="muted">none yet</td></tr>';
          $('#fk-3ds').checked = !!s.threeDS;
          $('#fk-calls').textContent = s.calls.slice().reverse().map((c) => `${c.method} ${c.path}  auth=${c.authorization ?? '-'}${c.apiKey ? '  X-Netpay-Apikey=' + c.apiKey : ''}\n   ${JSON.stringify(c.body).slice(0, 160)}`).join('\n') || '–';
        } catch { $('#fk-calls').textContent = 'stand-in Netpay is not reachable. Is `npm run stack` running?'; }
      }
      $('#fk-3ds').onchange = async (e) => { await fake('POST', '/three-ds', { enabled: e.target.checked }); refreshFake(); };
      $('#fk-refresh').onclick = refreshFake;
      $('#fk-fail').onclick = async () => { await fake('POST', '/fail-next', { status: Number($('#fk-status').value) }); refreshFake(); };
      $('#fk-override').onclick = async () => { await fake('POST', '/token-amount-override', { amount: $('#fk-amount').value }); refreshFake(); };
      $('#fk-reset').onclick = async () => { await fake('POST', '/reset'); refreshFake(); };
      let fakeTimer = null;
      $('#fk-auto').onchange = (e) => {
        clearInterval(fakeTimer);
        if (e.target.checked) fakeTimer = setInterval(refreshFake, 3000);
      };

      // ---------------------------------------------------------------- checks
      $('#run-checks').onclick = async () => {
        const list = $('#checks');
        list.innerHTML = '';
        let pass = 0, fail = 0;
        const record = (name, ok, detail = '') => {
          ok ? pass++ : fail++;
          const row = document.createElement('div');
          row.className = 'check';
          row.innerHTML = `<span class="mark ${ok ? 'st-ok' : 'st-bad'}">${ok ? '✓' : '✗'}</span><span>${esc(name)} ${ok ? '' : `<span class="muted">${esc(detail)}</span>`}</span>`;
          list.append(row);
          $('#run-summary').innerHTML = `<span class="st-ok">${pass} passed</span> · <span class="${fail ? 'st-bad' : 'muted'}">${fail} failed</span>`;
        };
        const expectStatus = async (name, promise, want) => {
          const r = await promise;
          record(name, r.status === want, `expected ${want}, got ${r.status} ${JSON.stringify(r.body).slice(0, 120)}`);
          return r;
        };
        const orderOf = async (id) => (await api('GET', `/t/payments/orders/${id}`, { actor: 'tenantOwner', quiet: true })).body;
        const waitStatus = async (id, want) => {
          for (let i = 0; i < 30; i++) {
            const o = await orderOf(id);
            if (want.includes(o.status)) return o;
            await sleep(300);
          }
          return orderOf(id);
        };
        const make = async (code, extra = {}) => {
          const r = await api('POST', '/t/payments/orders', { actor: 'tenantOwner', body: { merchantReferenceCode: code, amount: '650.00', ...extra } });
          if (r.status === 201) known[r.body.id] = r.body.checkout;
          return r.body;
        };
        const settle = async (order, status, amount = 650) => {
          const tx = `txn_chk_${Date.now()}_${++simCounter}`;
          await fake('POST', '/transactions', { id: tx, status, amount });
          await notify(state.webhookToken, order, tx);
          return tx;
        };

        if (stack?.realProvider) {
          record('these checks drive a stand-in Netpay; restart with `npm run stack` (not stack:real) to run them', false);
          return;
        }
        try {
          await fake('POST', '/reset');
          await signInAll();
          const need = ['tenantOwner', 'tenantAdmin', 'tenantViewer', 'platformOwner', 'platformAuditor'];
          record('all five accounts signed in', need.every((k) => state.sessions[k]));

          await expectStatus('VIEWER cannot store credentials', api('POST', '/t/payments/config', { actor: 'tenantViewer', body: { publicKey: CHK.pk, secretKey: CHK.sk, environment: 'SANDBOX' } }), 403);
          await expectStatus('AUDITOR cannot store credentials', api('POST', '/t/payments/config', { actor: 'platformAuditor', body: { publicKey: CHK.pk, secretKey: CHK.sk, environment: 'SANDBOX' } }), 403);
          await expectStatus('malformed key is rejected', api('POST', '/t/payments/config', { actor: 'tenantOwner', body: { publicKey: 'bad', secretKey: CHK.sk, environment: 'SANDBOX' } }), 400);
          const cfg = await expectStatus('OWNER stores credentials', api('POST', '/t/payments/config', { actor: 'tenantOwner', body: { publicKey: CHK.pk, secretKey: CHK.sk, environment: 'SANDBOX' } }), 200);
          record('the secret is never returned', !JSON.stringify(cfg.body).includes('sk_netpay'));
          if (cfg.body.webhookToken) setHookToken(cfg.body.webhookToken);
          if (!state.webhookToken) { record('inbound webhook token is known (paste it in Setup if the tenant was configured before)', false); return; }
          await expectStatus('ADMIN may configure payments', api('POST', '/t/payments/config', { actor: 'tenantAdmin', body: { publicKey: CHK.pk, secretKey: CHK.sk, environment: 'SANDBOX' } }), 200);

          const o1 = await make(`CHK-PAID-${Date.now()}`);
          record('a hosted order returns the page Netpay hosts', String(o1.checkout?.hostedCheckoutUrl).startsWith('https://gateway-154.netpaydev.com/hosted-checkout/session/'));
          const plus = await make(`CHK-PLUS-${Date.now()}`, { checkoutMode: 'plus' });
          record('a Checkout Plus order carries a server-side amount token', typeof plus.checkout?.amountToken === 'string' && plus.checkout.amountToken.startsWith('tokenAmount_'));
          await expectStatus('a hosted order outside MXN is refused', api('POST', '/t/payments/orders', { actor: 'tenantOwner', body: { merchantReferenceCode: 'CHK-USD', amount: '10.00', currency: 'USD' } }), 400);
          const before = await orderOf(o1.id);
          await notify(state.webhookToken, before, 'txn_chk_forged');
          await sleep(1200);
          const afterForged = await orderOf(o1.id);
          record('a forged notification leaves the order PENDING and unbound', afterForged.status === 'PENDING' && !afterForged.netpayTransactionId, afterForged.status);
          await settle(before, 'DONE');
          const paid = await waitStatus(o1.id, ['PAID']);
          record('the real notification settles it (PAID)', paid.status === 'PAID', paid.status);

          await expectStatus('VIEWER cannot refund', api('POST', `/t/payments/orders/${o1.id}/refund`, { actor: 'tenantViewer' }), 403);
          const rf = await expectStatus('OWNER refunds', api('POST', `/t/payments/orders/${o1.id}/refund`, { actor: 'tenantOwner' }), 200);
          record('status is REFUNDED', rf.body.status === 'REFUNDED');
          await expectStatus('a second refund is refused', api('POST', `/t/payments/orders/${o1.id}/refund`, { actor: 'tenantOwner' }), 409);

          const o2 = await make(`CHK-DECL-${Date.now()}`);
          await settle(await orderOf(o2.id), 'REJECT');
          record('declined by the provider is FAILED', (await waitStatus(o2.id, ['FAILED'])).status === 'FAILED');
          const o3 = await make(`CHK-MISM-${Date.now()}`);
          await settle(await orderOf(o3.id), 'DONE', 1);
          record('a different amount is AMOUNT_MISMATCH', (await waitStatus(o3.id, ['AMOUNT_MISMATCH'])).status === 'AMOUNT_MISMATCH');

          const o4 = await make(`CHK-CHG-${Date.now()}`, { checkoutMode: 'custom' });
          const bill = { firstName: 'Ana', lastName: 'Lopez', email: 'ana@example.mx', phone: '5512345678', address: { street1: 'Filosofos 100', street2: 'Tecnologico', city: 'Monterrey', state: 'NL', postalCode: '65700', country: 'MX' } };
          await expectStatus('a card number is refused where a token belongs', api('POST', `/t/payments/orders/${o4.id}/charge`, { actor: 'tenantOwner', body: { cardToken: '4111111111111111', billing: bill } }), 400);
          await expectStatus('a charge without billing is refused', api('POST', `/t/payments/orders/${o4.id}/charge`, { actor: 'tenantOwner', body: { cardToken: 'token_abcdefghijklmnop' } }), 400);
          const chg = await expectStatus('a token is charged', api('POST', `/t/payments/orders/${o4.id}/charge`, { actor: 'tenantOwner', body: { cardToken: 'token_abcdefghijklmnop', billing: bill } }), 200);
          await expectStatus('a repeat charge on a settled order is refused', api('POST', `/t/payments/orders/${o4.id}/charge`, { actor: 'tenantOwner', body: { cardToken: 'token_abcdefghijklmnop', billing: bill } }), 409);
          record('the charge settles the order at once, from the provider\'s own answer', chg.body.orderStatus === 'PAID' && (await orderOf(o4.id)).status === 'PAID', chg.body.orderStatus);

          await fake('POST', '/three-ds', { enabled: true });
          const o7 = await make(`CHK-3DS-${Date.now()}`, { checkoutMode: 'custom' });
          const c3 = await expectStatus('a charge that needs 3-D Secure succeeds', api('POST', `/t/payments/orders/${o7.id}/charge`, { actor: 'tenantOwner', body: { cardToken: 'token_abcdefghijklmnop', billing: bill } }), 200);
          const ch3 = c3.body.threeDSecureResponse ?? {};
          record('the 3DS challenge is handed back', ch3.status === 'PROCEED_TO_VALIDATE_AUTHENTICATION' && !!ch3.acsUrl && !!ch3.paReq && !!ch3.authenticationTransactionID);
          await expectStatus('VIEWER cannot confirm', api('POST', `/t/payments/orders/${o7.id}/confirm`, { actor: 'tenantViewer', body: { processorTransactionId: 'proc-1' } }), 403);
          await expectStatus('confirming without the processor id is refused', api('POST', `/t/payments/orders/${o7.id}/confirm`, { actor: 'tenantOwner', body: {} }), 400);
          await expectStatus('the charge is confirmed after authentication', api('POST', `/t/payments/orders/${o7.id}/confirm`, { actor: 'tenantOwner', body: { processorTransactionId: 'proc-1' } }), 200);
          record('and the order settles', (await waitStatus(o7.id, ['PAID'])).status === 'PAID');
          await expectStatus('confirming a settled order is refused', api('POST', `/t/payments/orders/${o7.id}/confirm`, { actor: 'tenantOwner', body: { processorTransactionId: 'proc-1' } }), 409);

          const o5 = await make(`CHK-RACE-${Date.now()}`);
          await settle(await orderOf(o5.id), 'DONE');
          await waitStatus(o5.id, ['PAID']);
          const race = await Promise.all([1, 2, 3, 4].map(() => api('POST', `/t/payments/orders/${o5.id}/refund`, { actor: 'tenantOwner', quiet: true })));
          record('four concurrent refunds reverse the order once', race.filter((r) => r.status === 200).length === 1, race.map((r) => r.status).join(','));

          const old = state.webhookToken;
          const rot = await expectStatus('inbound token is rotated', api('POST', '/t/payments/config/webhook-token', { actor: 'tenantOwner' }), 200);
          const o6 = await make(`CHK-ROT-${Date.now()}`);
          const tx6 = `txn_chk_old_${Date.now()}`;
          await fake('POST', '/transactions', { id: tx6, status: 'DONE', amount: 650 });
          await notify(old, await orderOf(o6.id), tx6);
          await sleep(1200);
          record('the retired token is ignored', (await orderOf(o6.id)).status === 'PENDING');
          setHookToken(rot.body.token);

          await expectStatus('ADMIN cannot register an outbound destination', api('POST', '/t/webhooks', { actor: 'tenantAdmin', body: { url: 'https://8.8.8.8/hook', events: ['payment.paid'] } }), 403);
          await expectStatus('a loopback destination is refused', api('POST', '/t/webhooks', { actor: 'tenantOwner', body: { url: 'https://127.0.0.1/x', events: ['payment.paid'] } }), 400);
          await expectStatus('the cloud metadata address is refused', api('POST', '/t/webhooks', { actor: 'tenantOwner', body: { url: 'https://169.254.169.254/', events: ['payment.paid'] } }), 400);
          const hook = await expectStatus('OWNER registers a destination', api('POST', '/t/webhooks', { actor: 'tenantOwner', body: { url: 'https://8.8.8.8/hook', events: ['payment.paid'] } }), 201);
          record('its signing secret is shown once', String(hook.body.secret).startsWith('whsec_'));
          const listed = await api('GET', '/t/webhooks', { actor: 'tenantOwner', quiet: true });
          record('and is not listed afterwards', !JSON.stringify(listed.body).includes(hook.body.secret));
        } catch (error) {
          record('the run completed without an unexpected error', false, String(error));
        }
        refreshOrders(true);
      };

      // ------------------------------------------------------------------ boot
      (async () => {
        try {
          stack = await (await fetch('/stack.json', { cache: 'no-store' })).json();
          $('#stack-state').textContent = `tenant ${stack.tenantSlug}${stack.realProvider ? ' · REAL Netpay sandbox' : ' · stand-in Netpay'}`;
          $('#real-note').classList.toggle('hidden', !stack.realProvider);
        } catch {
          $('#stack-state').innerHTML = '<span class="st-bad">stack.json not found. Run `npm run stack` first.</span>';
        }
        if (stack?.netpay) {
          // The stack already stored the keys in the demo tenant, so the page starts configured.
          $('#cfg-pk').value = stack.netpay.publicKey;
          $('#cfg-sk').value = '';
          $('#cfg-sk').placeholder = 'loaded by the stack (stays on the server)';
          $('#cfg-env').value = stack.netpay.environment;
          if (!state.webhookToken && stack.netpay.webhookToken) state.webhookToken = stack.netpay.webhookToken;
          $('#loaded-note').classList.remove('hidden');
        }
        setHookToken(state.webhookToken);
        renderActors();
        // Prefill the credential fields with the demo shape, so Setup can be used
        // without the stack having injected real sandbox keys.
        if (!$('#cfg-pk').value) $('#cfg-pk').value = DEMO.pk;
        if (!$('#cfg-sk').value) $('#cfg-sk').value = DEMO.sk;
        if (!$('#lnk-code').value) $('#lnk-code').placeholder = `LINK-${Date.now().toString().slice(-6)}`;
        // Sign in every demo account up front, so the page is usable on load. Tokens
        // from an earlier visit are dropped: the stack issues new accounts on each start.
        if (stack) {
          state.sessions = {};
          await signInAll();
        }
        showTab(sessionStorage.getItem(`${STORE}-tab`) || 'Setup');
      })();
    </script>
  </body>
</html>
